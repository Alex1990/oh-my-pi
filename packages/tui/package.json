{
	"type": "module",
	"name": "@oh-my-pi/pi-tui",
	"version": "18.12.3",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"contributors": [
		"Mario Zechner"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alex1990/oh-your-pi.git",
		"directory": "packages/tui"
	},
	"bugs": {
		"url": "https://github.com/Alex1990/oh-your-pi/issues"
	},
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "vitest run --parallel test/*.test.ts",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
		"gen:glyphs": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/gen-glyphs.ts"
	},
	"dependencies": {
		"@oh-my-pi/omptype": "catalog:",
		"@oh-my-pi/pi-agent-core": "catalog:",
		"@oh-my-pi/pi-ai": "catalog:",
		"@oh-my-pi/pi-catalog": "catalog:",
		"@oh-my-pi/pi-natives": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"@oh-my-pi/pi-wire": "catalog:",
		"@oh-my-pi/snapcompact": "catalog:"
	},
	"devDependencies": {
		"kitty-vt-wasm": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./theme": {
			"types": "./src/theme/index.ts",
			"import": "./src/theme/index.ts"
		},
		"./theme/defaults": {
			"types": "./src/theme/defaults/index.ts",
			"import": "./src/theme/defaults/index.ts"
		},
		"./theme/*": {
			"types": "./src/theme/*.ts",
			"import": "./src/theme/*.ts"
		},
		"./render": {
			"types": "./src/render/index.ts",
			"import": "./src/render/index.ts"
		},
		"./chrome": {
			"types": "./src/chrome/index.ts",
			"import": "./src/chrome/index.ts"
		},
		"./tools": {
			"types": "./src/tools/index.ts",
			"import": "./src/tools/index.ts"
		},
		"./status-line": {
			"types": "./src/status-line/index.ts",
			"import": "./src/status-line/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./components/*": {
			"types": "./src/components/*.ts",
			"import": "./src/components/*.ts"
		},
		"./native/*": {
			"types": "./src/native/*.ts",
			"import": "./src/native/*.ts"
		},
		"./*.js": "./src/*.ts"
	}
}
