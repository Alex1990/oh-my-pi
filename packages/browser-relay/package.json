{
	"type": "module",
	"name": "@oh-my-pi/browser-relay",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome extension that lets the omp browser tool drive your existing tabs (relay server lives in the omp CLI: `omp browser-relay`)",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alex1990/oh-your-pi.git",
		"directory": "packages/browser-relay"
	},
	"scripts": {
		"build": "node scripts/build-extension.ts",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"devDependencies": {
		"puppeteer-core": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"@types/node": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
