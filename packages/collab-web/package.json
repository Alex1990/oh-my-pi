{
	"type": "module",
	"name": "@oh-my-pi/collab-web",
	"version": "16.3.6",
	"private": true,
	"description": "Browser guest client and local relay tools for omp collab live sessions",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/collab-web"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"collab",
		"relay",
		"websocket",
		"react",
		"agent"
	],
	"scripts": {
		"dev": "vite",
		"mock-host": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/mock-host.ts",
		"relay": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/local-relay.ts",
		"build": "vite build",
		"gen:tool-views": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/build-tool-views.ts",
		"prepack": "pnpm run build",
		"test": "vitest run",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "catalog:",
		"@oh-my-pi/pi-wire": "catalog:",
		"lucide-react": "catalog:",
		"katex": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/node": "catalog:",
		"vite": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"public",
		"index.html",
		"README.md",
		"CHANGELOG.md"
	]
}
