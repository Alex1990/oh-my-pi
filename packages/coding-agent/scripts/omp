#!/bin/sh
# Dev launcher for the omp CLI, installed by `pnpm run setup`.
#
# Runs the TypeScript entrypoint directly on Node (which strips types natively);
# `--experimental-transform-types` is required because a few modules use `enum`.
set -e

# Resolve this script's real location even when invoked through a symlink.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
cli=$scripts_dir/../src/cli.ts
loader=$scripts_dir/../../../scripts/node-runtime-loader.mjs

exec node --experimental-transform-types --import "$loader" "$cli" "$@"
