{
	"type": "module",
	"name": "@oh-my-pi/omp-stats",
	"version": "18.12.3",
	"description": "Local observability dashboard for omp AI usage statistics",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alex1990/oh-your-pi.git",
		"directory": "packages/stats"
	},
	"bugs": {
		"url": "https://github.com/Alex1990/oh-your-pi/issues"
	},
	"keywords": [
		"ai",
		"observability",
		"metrics",
		"dashboard",
		"llm",
		"statistics"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"omp-stats": "./src/bin.ts"
	},
	"scripts": {
		"gen:stats": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/generate-client-bundle.ts --generate",
		"gen:stats:reset": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/generate-client-bundle.ts --reset",
		"build": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs build.ts",
		"dev": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs src/index.ts",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/pi-ai": "catalog:",
		"@oh-my-pi/pi-catalog": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/node": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"src",
		"build.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./client": {
			"types": "./src/client/index.tsx",
			"import": "./src/client/index.tsx"
		},
		"./client/*": {
			"types": "./src/client/*.ts",
			"import": "./src/client/*.ts"
		},
		"./client/components/*": {
			"types": "./src/client/components/*.ts",
			"import": "./src/client/components/*.ts"
		},
		"./*.js": "./src/*.ts"
	}
}
