{
	"name": "@oh-my-pi/pi-catalog",
	"version": "18.12.2",
	"description": "Model catalog for omp: bundled model database, provider discovery descriptors, model identity, classification, and equivalence",
	"keywords": [
		"ai",
		"catalog",
		"discovery",
		"llm",
		"models"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/Alex1990/oh-your-pi/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alex1990/oh-your-pi.git",
		"directory": "packages/catalog"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./models.json": {
			"types": "./src/models.json.d.ts",
			"import": "./src/models.json"
		},
		"./provider-models": {
			"types": "./src/provider-models/index.ts",
			"import": "./src/provider-models/index.ts"
		},
		"./provider-models/*": {
			"types": "./src/provider-models/*.ts",
			"import": "./src/provider-models/*.ts"
		},
		"./discovery": {
			"types": "./src/discovery/index.ts",
			"import": "./src/discovery/index.ts"
		},
		"./discovery/*": {
			"types": "./src/discovery/*.ts",
			"import": "./src/discovery/*.ts"
		},
		"./identity": {
			"types": "./src/identity/index.ts",
			"import": "./src/identity/index.ts"
		},
		"./identity/*": {
			"types": "./src/identity/*.ts",
			"import": "./src/identity/*.ts"
		},
		"./wire/*": {
			"types": "./src/wire/*.ts",
			"import": "./src/wire/*.ts"
		},
		"./compat/*": {
			"types": "./src/compat/*.ts",
			"import": "./src/compat/*.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "vitest run --parallel",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
		"gen:models": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/generate-models.ts",
		"gen:compat": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/compile-compat.ts",
		"gen:proto": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/generate-protocols.ts"
	},
	"dependencies": {
		"@oh-my-pi/omptype": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:"
	},
	"devDependencies": {
		"@bgotink/kdl": "0.4.0",
		"@oh-my-pi/pi-ai": "catalog:",
		"@oh-my-pi/pi-coding-agent": "catalog:",
		"@types/node": "catalog:"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
