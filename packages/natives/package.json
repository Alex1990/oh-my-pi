{
	"name": "@oh-my-pi/pi-natives",
	"version": "18.12.2",
	"description": "Native Rust bindings for PDF conversion, audio, WebRTC, grep, clipboard, image processing, syntax highlighting, PTY, and shell operations via N-API",
	"type": "module",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alex1990/oh-your-pi.git",
		"directory": "packages/natives"
	},
	"bugs": {
		"url": "https://github.com/Alex1990/oh-your-pi/issues"
	},
	"keywords": [
		"napi",
		"rust",
		"native",
		"grep",
		"text-processing",
		"clipboard",
		"image",
		"pty",
		"shell",
		"syntax-highlighting"
	],
	"main": "./native/index.js",
	"types": "./native/index.d.ts",
	"scripts": {
		"build": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs ../../scripts/bazel-natives.ts host --dest native",
		"build:bindings": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/build-bindings.ts",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && pnpm run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "vitest run --parallel",
		"fix": "oxlint --fix --fix-suggestions . && pnpm run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
		"gen:npm": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs scripts/gen-npm-packages.ts",
		"bench": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs bench/grep.ts",
		"bench:text": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs bench/text.ts",
		"bench:ipc": "node --experimental-transform-types --import ../../scripts/node-runtime-loader.mjs bench/ipc.ts"
	},
	"devDependencies": {
		"@napi-rs/cli": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"@types/node": "catalog:",
		"cli-truncate": "6.1.1",
		"diff": "9.0.0",
		"gpt-tokenizer": "4.0.0",
		"mitata": "1.0.34",
		"slice-ansi": "9.0.0",
		"string-width": "8.2.2",
		"wrap-ansi": "10.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"napi": {
		"binaryName": "pi_natives",
		"triples": {}
	},
	"files": [
		"src",
		"native",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./native/index.d.ts",
			"import": "./native/index.js",
			"default": "./native/index.js"
		},
		"./path": {
			"types": "./native/path.d.ts",
			"import": "./native/path.js",
			"default": "./native/path.js"
		},
		"./desktop": {
			"types": "./native/desktop.d.ts",
			"import": "./native/desktop.js",
			"default": "./native/desktop.js"
		},
		"./clipboard": {
			"types": "./native/clipboard.d.ts",
			"import": "./native/clipboard.js",
			"default": "./native/clipboard.js"
		},
		"./vcs": {
			"types": "./native/vcs.d.ts",
			"import": "./native/vcs.js",
			"default": "./native/vcs.js"
		}
	}
}
